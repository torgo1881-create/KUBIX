{
  "name": "photo-mosaic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/gridAverage.test.mjs tests/color.test.mjs tests/pieceLimit.test.mjs tests/face.test.mjs tests/variants.test.mjs tests/instruction.test.mjs tests/production.test.mjs tests/presets.test.mjs tests/tuning.test.mjs tests/choices.test.mjs tests/gridDetail.test.mjs",
    "test:browser": "node --test tests/flow.browser.mjs tests/production.browser.mjs tests/presets.browser.mjs",
    "test:all": "npm run test && npm run build:standalone && npm run test:browser && npm run test:performance",
    "build:standalone": "node tools/build-standalone.mjs",
    "test:color": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/color.test.mjs",
    "test:limits": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/pieceLimit.test.mjs",
    "bench": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/benchmark.mjs",
    "test:face": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/face.test.mjs",
    "test:variants": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/variants.test.mjs",
    "test:instruction": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/instruction.test.mjs",
    "test:production": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/production.test.mjs",
    "test:performance": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/performance.test.mjs",
    "test:presets": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/presets.test.mjs",
    "exp:9b": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/experiment-9b.mjs",
    "exp:9c": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/experiment-9c.mjs",
    "exp:10": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/experiment-10.mjs",
    "exp:11": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/experiment-11.mjs",
    "exp:12": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/experiment-12.mjs",
    "build:artifact": "node tools/build-standalone.mjs && node tools/build-artifact.mjs",
    "check:mobile": "node tools/mobile-check.mjs",
    "tune": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/tune.mjs",
    "choices": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/choices-report.mjs",
    "test:tuning": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/tuning.test.mjs tests/choices.test.mjs",
    "exp:13": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs tools/experiment-13.mjs",
    "test:detail": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/hooks/register.mjs --test tests/gridDetail.test.mjs",
    "prebuild": "node tools/build-standalone.mjs && node tools/publish-standalone.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.49.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
